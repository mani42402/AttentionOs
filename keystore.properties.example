# Release signing configuration.
#
# Copy to `keystore.properties` (gitignored) and fill in real values.
# Without this file the project still builds; `assembleRelease` simply produces
# an unsigned APK. Never commit the real file or the .jks it points at.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias attentionos
#
# Paths are resolved relative to the repository root.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=attentionos
keyPassword=CHANGE_ME
